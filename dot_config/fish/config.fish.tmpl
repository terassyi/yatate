# Fish shell configuration -- managed by chezmoi
# OS: {{ .os }} | Headless: {{ .headless }}

# ── Locale ─────────────────────────────────────────────
set -gx LANG en_US.UTF-8

# ── Environment variables ──────────────────────────────
set -gx COLORTERM truecolor
set -gx GH_REPO_HOME $HOME/workspace/github.com

# ── Skim defaults ──────────────────────────────────────
set -gx SKIM_DEFAULT_COMMAND 'rg --files --hidden --follow --glob "!.git/*"'
set -gx SKIM_DEFAULT_OPTIONS "--color=fg:#e6e6fa,fg+:#333333,bg+:#dda0dd,pointer:#ff0000,hl:#dda0dd,hl+:#dda0dd --height=30% --layout=reverse"

# ── PATH ───────────────────────────────────────────────
fish_add_path $HOME/.local/bin
fish_add_path $HOME/.local/share/aquaproj-aqua/bin
{{ if .is_darwin -}}
fish_add_path /opt/homebrew/bin
fish_add_path $HOME/.rd/bin
{{ end -}}

# Tool paths managed by tomei
if command -q tomei
    tomei env --shell fish | source
end

if test -d /nix
    fish_add_path /nix/var/nix/profiles/default/bin
    fish_add_path $HOME/.nix-profile/bin
end

# --- SSH Agent ---

# Pin the socket with -a so every shell reuses one agent. `eval (ssh-agent -c)`
# overwrote SSH_AUTH_SOCK with a fresh per-shell socket, leaking one agent per
# shell. ssh-add failing means no usable agent (missing or stale socket), so
# start one and load the key.
if not set -q SSH_AUTH_SOCK
    set -gx SSH_AUTH_SOCK ~/.ssh/agent.sock
    if not ssh-add -l >/dev/null 2>&1
        rm -f $SSH_AUTH_SOCK
        ssh-agent -a $SSH_AUTH_SOCK >/dev/null
        ssh-add ~/.ssh/id_ed25519 2>/dev/null
    end
end

# ── Aliases ────────────────────────────────────────────
alias .. 'cd ..'
alias cl clear
if command -q eza
    alias ls eza
    alias ll 'eza -lh'
    alias la 'eza -alh'
end
if command -q nvim
    alias vim nvim
    alias vi nvim
    set -gx EDITOR nvim
end

# ── Abbreviations ──────────────────────────────────────
abbr -a g git
abbr -a ga 'git add'
abbr -a gc 'git commit'
abbr -a gd 'git diff'
abbr -a gl 'git log'
abbr -a gs 'git status'
abbr -a gps 'git push'
abbr -a gpl 'git pull'
abbr -a gsw 'git switch'
abbr -a k kubectl
abbr -a zl zellij
abbr -a hd herdr
# `hr <ssh-target>` attaches to a remote herdr server over SSH.
abbr -a hr 'herdr --remote'
abbr -a zgh 'z ~/workspace/github.com'

# ── Interactive shell setup ────────────────────────────
if status is-interactive
    set -gx TERM xterm-256color

    if command -q sk
        skim_key_bindings

        bind \cr sk_history
        bind \cf sk_bat
        bind \cd sk_zoxide
        bind \cu sk_zoxide_gh
        bind \cv sk_code_repo
    end
end
