#!/bin/bash
set -euo pipefail

# tomei manifest hashes (triggers re-run on change):
# {{ include "dot_config/tomei/common-tools.cue" | sha256sum }}
# {{ include "dot_config/tomei/tomei_platform.cue" | sha256sum }}
# {{ include "dot_config/tomei/runtimes.cue" | sha256sum }}
# {{ include "dot_config/tomei/lang-tools.cue" | sha256sum }}
# {{ include "dot_config/tomei/darwin-brew.cue" | sha256sum }}
# {{ include "dot_config/tomei/linux-tools.cue" | sha256sum }}
# {{ include "dot_config/tomei/darwin2-extras.cue.tmpl" | sha256sum }}

TOMEI_DIR="${HOME}/.config/tomei"

if ! command -v tomei &>/dev/null; then
    echo "WARN: tomei not found, skipping"
    exit 0
fi

if [ ! -d "$TOMEI_DIR" ]; then
    echo "WARN: $TOMEI_DIR not found, skipping"
    exit 0
fi

tomei init --yes
tomei validate "$TOMEI_DIR"

{{ if .is_darwin -}}
# darwin: Homebrew は privileged リソース。sudo は tomei が必要な時だけ内部プロンプト。
# CI (GitHub Actions 等) は brew が pre-install 済みで、tomei の #Homebrew が
# sudo で wrap されると brew install スクリプトが root 実行を reject するため
# --system を付けない（privileged リソースはスキップされる）。
if [ -n "${CI:-}" ]; then
    TOMEI_APPLY_FLAGS=""
else
    TOMEI_APPLY_FLAGS="--system"
fi
{{ else -}}
TOMEI_APPLY_FLAGS=""
{{ end -}}

if [ "${SKIP_TOMEI_APPLY:-}" = "true" ]; then
    echo "Skipping tomei apply (SKIP_TOMEI_APPLY=true)"
else
    if ! tomei apply --yes ${TOMEI_APPLY_FLAGS} "$TOMEI_DIR"; then
        echo "ERROR: tomei apply failed"
        echo "==> Failed resources:"
        tomei logs --no-color
        # Show detailed logs for each failed resource
        for res in $(tomei logs --no-color 2>/dev/null | grep -oE '[A-Z][a-z]+/[^ ]+'); do
            echo "==> Log: $res"
            tomei logs --no-color "$res" 2>/dev/null || true
        done
        exit 1
    fi
    echo "tomei apply completed"
fi
