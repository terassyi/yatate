#!/bin/bash
set -euo pipefail

# tomei manifest hashes (triggers re-run on change):
# {{ include "dot_config/tomei/cue.mod/module.cue" | sha256sum }}
# {{ include "dot_config/tomei/common-tools.cue" | sha256sum }}
# {{ include "dot_config/tomei/tomei_platform.cue" | sha256sum }}
# {{ include "dot_config/tomei/runtimes.cue" | sha256sum }}
# {{ include "dot_config/tomei/lang-tools.cue" | sha256sum }}
# {{ include "dot_config/tomei/darwin-brew.cue" | sha256sum }}
# {{ include "dot_config/tomei/linux-tools.cue" | sha256sum }}
# {{ include "dot_config/tomei/work-darwin-extras.cue.tmpl" | sha256sum }}

TOMEI_DIR="${HOME}/.config/tomei"

if ! command -v tomei &>/dev/null; then
    echo "WARN: tomei not found, skipping"
    exit 0
fi

if [ ! -d "$TOMEI_DIR" ]; then
    echo "WARN: $TOMEI_DIR not found, skipping"
    exit 0
fi

tomei init --yes
tomei validate "$TOMEI_DIR"

{{ if .is_darwin -}}
# darwin: CI では --system を付けない。macOS runner は Homebrew が pre-install 済みで、
# CI で formula を入れ直すのは重く不要なため privileged リソースはスキップする。
# 実機 bootstrap (CI 以外) では --system で Homebrew/brewTools を適用する。
if [ -n "${CI:-}" ]; then
    TOMEI_APPLY_FLAGS=""
else
    TOMEI_APPLY_FLAGS="--system"
fi
{{ else -}}
# linux: 常に --system。apt SystemPackage (base/build/bpf/... の各 SystemPackageSet)
# は sudo を使うが、CI コンテナ/ランナーでは sudo が passwordless なので非対話で通り、
# テストが実際の SystemPackage 導入フローを検証できる。
TOMEI_APPLY_FLAGS="--system"
{{ end -}}

if [ "${SKIP_TOMEI_APPLY:-}" = "true" ]; then
    echo "Skipping tomei apply (SKIP_TOMEI_APPLY=true)"
else
    # --sync: refresh the cached aqua-registry ref to the latest before
    # resolving packages. tomei pins the registry ref in its state at first
    # `tomei init` and never re-syncs it on its own, so a machine whose state
    # predates a newly-added registry package (e.g. ogulcancelik/herdr) fails
    # with "package not found" until synced. Tool versions stay pinned, so this
    # only advances resolution metadata, not the installed tool versions.
    if ! tomei apply --sync --yes ${TOMEI_APPLY_FLAGS} "$TOMEI_DIR"; then
        echo "ERROR: tomei apply failed"
        echo "==> Failed resources:"
        tomei logs --no-color
        # Show detailed logs for each failed resource
        for res in $(tomei logs --no-color 2>/dev/null | grep -oE '[A-Z][a-z]+/[^ ]+'); do
            echo "==> Log: $res"
            tomei logs --no-color "$res" 2>/dev/null || true
        done
        exit 1
    fi
    echo "tomei apply completed"
fi
