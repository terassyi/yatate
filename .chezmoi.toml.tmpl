{{- /* Host info */ -}}
{{- $os := .chezmoi.os -}}
{{- $username := .chezmoi.username -}}

{{- /* Profile (personal / work / test). Resolution order:
       1. DOTFILES_PROFILE env — explicit override; use this to switch profiles
          (e.g. `DOTFILES_PROFILE=work chezmoi init`). The value is persisted in
          [data].profile below.
       2. CI/containers: test (runner = GitHub Actions, testuser = container).
       3. Otherwise asked once on `chezmoi init`, then reused from the persisted
          [data].profile on later runs.
       Never derived from the hostname, so no internal hostname is exposed. */ -}}
{{- $profile := "" -}}
{{- if env "DOTFILES_PROFILE" -}}
  {{- $profile = env "DOTFILES_PROFILE" -}}
{{- else if or (eq $username "runner") (eq $username "testuser") -}}
  {{- $profile = "test" -}}
{{- else -}}
  {{- $profile = promptChoiceOnce . "profile" "Select dotfiles profile" (list "personal" "work") -}}
{{- end -}}

{{- /* Headless (no desktop GUI). DOTFILES_HEADLESS=true/false overrides;
       darwin is always GUI; CI is headless; otherwise asked once and reused. */ -}}
{{- $headless := true -}}
{{- if env "DOTFILES_HEADLESS" -}}
  {{- $headless = (eq (env "DOTFILES_HEADLESS") "true") -}}
{{- else if eq $os "darwin" -}}
  {{- $headless = false -}}
{{- else if or (eq $username "runner") (eq $username "testuser") -}}
  {{- $headless = true -}}
{{- else -}}
  {{- $headless = promptBoolOnce . "headless" "Headless (no desktop GUI)?" true -}}
{{- end -}}

encryption = "age"

[edit]
command = "nvim"

[diff]
pager = "delta"

[merge]
command = "nvim"
args = ["-d"]

[age]
identity = "~/.config/chezmoi/key-{{ $profile }}.txt"
{{- if eq $profile "work" }}
recipient = "age1p4kg9mlawasn4dh9ug8xndptnry0yu6ec7nhtwvk0la3qzm3dy4qmh88e8"
{{- else if eq $profile "personal" }}
recipient = "age1jlp689wyctgklkajtllwwspmuz9c9mmntd9l279trx2r9vushstqnga25d"
{{- else }}
recipient = "age148yv50pmelaed8wt2yykc57ycv74jm9wc6l6udg9ekx82qc2pq4qqyfalq"
{{- end }}

[data]
username  = "{{ $username }}"
os        = "{{ $os }}"
headless  = {{ $headless }}
is_darwin = {{ eq $os "darwin" }}
is_linux  = {{ eq $os "linux" }}
profile   = "{{ $profile }}"
{{- if eq $profile "work" }}
skills_repo = "cybozu-private/terashima-skills"
{{- else }}
skills_repo = "terassyi/skills"
{{- end }}
